        {
            "_type": "section",
            "_id": "f239d48e7aff",
            "_label": "Practice and courts",
            "bg_color": "var(--rl-color-surface)",
            "padding_top": "var(--rl-space-2xl)",
            "padding_bottom": "var(--rl-space-2xl)",
            "_elements": [
                {
                    "_type": "row",
                    "_id": "d2de78857ad4",
                    "_elements": [
                        {
                            "_type": "column",
                            "_id": "ab109e0f413e",
